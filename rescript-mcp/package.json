{
  "name": "ms-access-mcp-rescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rescript",
    "dev": "rescript watch",
    "clean": "rescript clean",
    "clean:all": "rescript clean && node -e \"const p=require.resolve('rescript-test/package.json');const{execSync}=require('child_process');const{dirname}=require('path');execSync('npx rescript',{cwd:dirname(p),stdio:'inherit'})\" && rescript",
    "test": "retest \"test/**/*.res.mjs\"",
    "lint:cases": "node parity/lint-cases.mjs",
    "build:parity": "tsc -p parity/tsconfig.json",
    "parity": "node parity/dist/run.js",
    "parity:northwind": "node -e \"process.env.ACCESS_TEST_DB=require('path').resolve(__dirname,'..','db','northwind.accdb');process.env.ACCESS_TEST_ASSUME_ACE='1';process.argv=['node','run.js','--cases-dir=rescript-mcp/parity/cases/northwind','--require-read-only'];require('./parity/dist/run.js')\"",
    "parity:northwind:com": "pnpm build:parity && node -e \"process.env.ACCESS_TEST_DB=require('path').resolve(__dirname,'..','db','northwind.accdb');process.env.ACCESS_TEST_ASSUME_ACE='1';process.argv=['node','run.js','--cases-dir=rescript-mcp/parity/cases/northwind/com','--require-read-only'];require('./parity/dist/run.js')\"",
    "parity:northwind:com:mutating": "pnpm build:parity && node -e \"process.env.ACCESS_TEST_DB=require('path').resolve(__dirname,'..','db','northwind.accdb');process.env.ACCESS_TEST_ASSUME_ACE='1';process.argv=['node','run.js','--cases-dir=rescript-mcp/parity/cases/northwind/com/mutating'];require('./parity/dist/run.js')\"",
    "parity:northwind:ddl": "pnpm build:parity && node -e \"process.env.ACCESS_TEST_DB=require('path').resolve(__dirname,'..','db','northwind.accdb');process.env.ACCESS_TEST_ASSUME_ACE='1';process.argv=['node','run.js','--cases-dir=rescript-mcp/parity/cases/northwind/ddl','--require-read-only'];require('./parity/dist/run.js')\"",
    "parity:northwind:com:ddl": "pnpm build:parity && node -e \"process.env.ACCESS_TEST_DB=require('path').resolve(__dirname,'..','db','northwind.accdb');process.env.ACCESS_TEST_ASSUME_ACE='1';process.argv=['node','run.js','--cases-dir=rescript-mcp/parity/cases/northwind/com/ddl','--require-read-only'];require('./parity/dist/run.js')\"",
    "parity:types": ".venv\\Scripts\\python.exe -m mypy --strict --config-file=mypy.ini scripts/parity_driver.py scripts/inventory_fixture.py",
    "server": "node ./src/Mcp/main.mjs",
    "test:integration:odbc": "node test/odbc-integration/run.mjs",
    "test:integration:northwind:stdio": "node ./test/northwind-stdio/run.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rescript/runtime": "^12.0.0",
    "odbc": "^2.5.0",
    "rescript": "^12.2.0",
    "rescript-nodejs": "^17.0.0",
    "winax": "^3.6.9",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ajv": "^8.17.1",
    "rescript-test": "^8.0.1",
    "typescript": "^7.0.2"
  }
}
